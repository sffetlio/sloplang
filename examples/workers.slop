(struct Range (lo i64) (hi i64))

(fn sum_squares ((r Range)) i64 (var s 0) (for i (. r lo) (. r hi) (set s (+ s (* i i)))) s)

(fn fill ((b (buf i64))) (buf i64)
  (doc "owns b because it returns a buffer; hands it back filled")
  (for i 0 (len b) (put b i (* i 2)))
  b)

(fn total ((b (buf i64))) i64 (var s 0) (for i 0 (len b) (set s (+ s (get b i)))) s)

(fn producer ((out (chan i64)) (n i64)) unit (eff conc) (for i 1 (+ n 1) (send out i)) (close out))

(fn consumer ((inp (chan i64))) i64 (eff conc) (var s 0) (each x inp (set s (+ s x))) s)

(fn main () i64
  (eff io mem conc)
  (let g (group i64))
  (for k 0 8 (go g (sum_squares (mk Range (* k 1000) (* (+ k 1) 1000)))))
  (let parts (wait g))
  (print "sum of squares below 8000:" (total parts))
  (free parts)
  (let t (spawn (fill (alloc i64 10))))
  (let filled (join t))
  (print "filled total:" (total filled))
  (free filled)
  (let c (chan i64 16))
  (let p (spawn (producer c 1000)))
  (let q (spawn (consumer c)))
  (join p)
  (print "channel sum:" (join q))
  0)
